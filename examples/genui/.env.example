# Copy to .env.local (gitignored) and fill in. Read by the planner's LLM proxy
# (server/llm-proxy.ts) and, if you opt in below, by the build.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Demo builds: also bake the key into the app bundle, so the app calls Gemini
# itself — in `npm run build` output and in Lynx Explorer with no dev server.
# ⚠️ Anyone who gets the bundle can read the key. Use a key you can revoke.
# PLANNER_EMBED_KEY=true

# Optional — pin a model instead of auto-picking the newest Gemini Flash.
# LLM_MODEL=gemini-2.5-flash

# Optional — save every model exchange to .planner-logs/ (gitignored) to see
# exactly what the model generated when a screen looks wrong.
# PLANNER_DEBUG_LOG=true

# Optional — any other OpenAI-compatible provider (Groq, OpenRouter, Ollama, …):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
